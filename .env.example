# Google Gemini API Key
# Obtain your API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Default TTS Model (defaults to gemini-3.8-flash-tts)
# Supported options include: gemini-3.8-flash-tts, gemini-3.8-flash-lite-tts, gemini-2.5-flash, gemini-2.0-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-tts

# Optional: Default Voice Name
# Available options include: Kore, Puck, Zephyr, Aoede, Fenrir, Charon, Autonoe, Orus
DEFAULT_VOICE=Kore

# Audio Output Directory (relative to workspace or absolute)
AUDIO_OUTPUT_DIR=outputs
