# Page to Voice - Frontend Environment Variables

# Backend API base URL (required for real authentication)
# When set, login and registration make requests to this backend.
VITE_API_BASE_URL=http://localhost:5000/api

# Local Development Preview Mode (DEVELOPMENT ONLY)
# Set to 'true' to enable mock authentication for local UI testing when the backend is offline.
# Default: false (disabled).
# NOTE: This setting is automatically ignored and disabled in production builds.
VITE_ENABLE_AUTH_PREVIEW=false
