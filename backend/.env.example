# Database Connection (Aiven MySQL / Local MySQL)
DATABASE_URL=mysql://avnadmin:your_password@your_host:15135/defaultdb?ssl-mode=REQUIRED

DB_USER=avnadmin
DB_PASSWORD=your_mysql_password
DB_HOST=mysql-316f315c-corei35432-f37f.i.aivencloud.com
DB_PORT=15135
DB_NAME=defaultdb
DB_SSL_MODE=REQUIRED

# JWT Authentication
SECRET_KEY=your_jwt_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# Microsoft Azure AI Speech (Primary TTS Provider)
AZURE_SPEECH_KEY=your_azure_speech_resource_key
AZURE_SPEECH_REGION=eastus
AZURE_SPEECH_ENDPOINT=
TTS_PROVIDER=azure

# Optional Configurable Default Voices
AZURE_SPEECH_VOICE_EN=en-US-JennyNeural
AZURE_SPEECH_VOICE_TA=ta-IN-PallaviNeural
AZURE_SPEECH_VOICE_SI=si-LK-ThiliniNeural

# Optional ElevenLabs Flash v2.5 (Ultra-low latency English TTS)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_MODEL=eleven_flash_v2_5


